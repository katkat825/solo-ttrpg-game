{
  //  Not everything with a verb on it is somebody.

  "id": "example_chest",

  "can": {
    "examine": "the_chest_up_close",
    "search": null
  },

  // [REQUIRED for "search"] loot — a weighted table, exactly like a monster's. An entry with no
