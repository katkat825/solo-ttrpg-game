{
  //  AN ENCOUNTER — a room, who is in it, and what happens.

  "id": "example_room",   // [REQUIRED] local id; a chapter names the encounter by it
  "map": "example_room",  // [REQUIRED] a file in maps/ (without .map)

  // [REQUIRED] placements — who starts where (at least one).
  //   slot    : a spawn number drawn on the map (1-9)
  //   monster : a monster id from this campaign's monsters/ (bare, e.g. "example_grunt")
  "placements": [
    { "slot": 1, "monster": "example_pest" },
    { "slot": 2, "monster": "example_grunt" }
  ],

  // [OPTIONAL] triggers — what happens on an event.
  //   when : entered | cleared
  //   then : next (next encounter) | ends (end the chapter) | goto (add "encounter": "<id>")
  "triggers": [
    { "when": "cleared", "then": "next" }
  ],

  // [OPTIONAL] cues — DM stage directions (flavor). A cue's line is a locale key:
  //            dialogue.dm.narration.<campaign>.<cue>.
  //   when     : entered | cleared
  //   cue      : a local id (also the last segment of its narration key)
  //   gesture  : [opt] default 'push'. place, slide, push, tap, reachbehind, rest, withdraw, tack, turnpage, write, idle
  //   hesitant : [opt] true only on a 'place' (a beat before the mini goes down)
  //   at       : [opt] a spawn slot, only for gestures at a square (place, tap, slide)
  "cues": [
    // [OPTIONAL] "beat" - a beat from beats/ that whichever companion is at
    //            this table answers this moment with, in its own voice. A
    //            'plot' or 'hint' beat nothing reaches is refused at load.
    { "when": "entered", "cue": "room_opens", "beat": "warn_the_floor_is_thin" }
  ]
}
