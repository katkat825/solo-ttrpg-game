<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net10.0 because that's the runtime installed on this machine. `rules` stays
      on net8.0 because Godot 4.7 targets it; a net8.0 library referenced from a
      net10.0 app is fine. Bump this if you ever move rules forward.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sim</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\rules\rules.csproj" />
  </ItemGroup>

</Project>
