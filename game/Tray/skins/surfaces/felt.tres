; BORROWED, not felt. There is no felt recording yet, so this points at the wood pool
; and leans on ImpactDb and ImpactPitch to dull it - quieter and lower reads as softer,
; which is close enough to be convincing and is not the same as being right.
; The fix is a real recording: slice_impacts.py --out game/audio/samples/impacts/felt
AudioPool = "res://audio/samples/impacts/wood/"
ImpactDb = -4.0
ImpactPitch = 0.96
