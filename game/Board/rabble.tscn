[gd_scene load_steps=6 format=3]

; RABBLE, AS A PROXY - see rival.tscn for why the foes are pawns rather than models.
;
; A Rabble is SHORTER AND PALER than a Rival, and that is the whole of the tiering at a glance.
; It matters more here than anywhere else on the board: CORE_RULES.md section 8 says Rabble die to
; any hit and Rivals soak, so "which of these is worth the good die" is the question the player
; asks every turn, and it has to be answerable from across the table without reading anything.
; A room of eight is meant to be a puzzle, not a slog, and a puzzle you cannot see is neither.
;
; It also carries no vigor tally beside it - Fight.Enlist gives one only to a piece with a health
; track - so an empty patch of mat next to a piece means "one hit and it is gone".

[ext_resource type="Script" path="res://Board/Mini.cs" id="1_mini"]
[ext_resource type="Shader" path="res://shaders/painted_miniature.gdshader" id="2_shader"]

; dull bone, low contrast against the parchment on purpose: rabble should read as a crowd first
; and as individuals second
[sub_resource type="ShaderMaterial" id="Mat_rabble"]
shader = ExtResource("2_shader")
shader_parameter/tint = Color(0.55, 0.50, 0.42, 1)
shader_parameter/brush_strength = 0.20
shader_parameter/varnish = 0.06

; slate, the same base every piece in the game stands on - see mini.tscn
[sub_resource type="ShaderMaterial" id="Mat_base"]
shader = ExtResource("2_shader")
shader_parameter/tint = Color(0.23, 0.22, 0.25, 1)
shader_parameter/brush_strength = 0.14
shader_parameter/varnish = 0.08

; a smaller base as well as a smaller figure - 32 mm rather than 42, so a crowd of them fits
; round a hero without the bases overlapping into one grey mass
[sub_resource type="CylinderMesh" id="Mesh_base"]
top_radius = 0.016
bottom_radius = 0.019
height = 0.007
radial_segments = 20
rings = 1

[sub_resource type="CylinderMesh" id="Mesh_pawn"]
top_radius = 0.006
bottom_radius = 0.011
height = 0.05
radial_segments = 10
rings = 2

[node name="Rabble" type="Node3D"]
script = ExtResource("1_mini")
FigureHeight = 0.05
Paint = SubResource("Mat_rabble")

[node name="Base" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0035, 0)
mesh = SubResource("Mesh_base")
material_override = SubResource("Mat_base")

[node name="Figure" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.007, 0)
mesh = SubResource("Mesh_pawn")

[node name="Voice" type="AudioStreamPlayer3D" parent="."]
unit_size = 0.9
max_db = 4.0
attenuation_model = 0
panning_strength = 1.2
