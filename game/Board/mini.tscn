[gd_scene load_steps=6 format=3]

; One piece, as a placeholder - the mini equivalent of the d6 starting life as a BoxMesh.
;
; A wide, slightly flared base and a body that is heaviest low down, because B0 asks for a piece
; that LOOKS WEIGHTED. That is the only thing this shape is trying to say: it is not a hero, it
; is not a class, it is a lump on a square whose job is to prove that a piece on a board reads as
; a piece on a board. B5 pulls a real figure out of KayKit Adventurers and puts the
; painted-miniature shader on it, and everything below is thrown away then.
;
; About 70 mm tall standing on a 60 mm square, beside 50 mm dice - deliberately a set.

[ext_resource type="Script" path="res://Board/Mini.cs" id="1_mini"]

[sub_resource type="StandardMaterial3D" id="Mat_base"]
albedo_color = Color(0.07, 0.07, 0.08, 1)
roughness = 0.85

[sub_resource type="StandardMaterial3D" id="Mat_body"]
albedo_color = Color(0.44, 0.46, 0.52, 1)
roughness = 0.6
metallic = 0.15
metallic_specular = 0.4

[sub_resource type="CylinderMesh" id="Mesh_base"]
top_radius = 0.021
bottom_radius = 0.024
height = 0.008
radial_segments = 24
rings = 1

[sub_resource type="CapsuleMesh" id="Mesh_body"]
radius = 0.013
height = 0.062
radial_segments = 20
rings = 6

[node name="Mini" type="Node3D"]
script = ExtResource("1_mini")

[node name="Base" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.004, 0)
mesh = SubResource("Mesh_base")
material_override = SubResource("Mat_base")

[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.039, 0)
mesh = SubResource("Mesh_body")
material_override = SubResource("Mat_body")

; the set-down click. same 3D settings as the dice use, so a piece and a die placed side by side
; are heard at the same distance and the same width - see DieAudio.Take
[node name="Voice" type="AudioStreamPlayer3D" parent="."]
unit_size = 0.9
max_db = 0.0
attenuation_model = 0
panning_strength = 1.2
