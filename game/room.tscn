[gd_scene load_steps=15 format=3]

; THE ROOM. The game's main scene from R3 onward, and the shell that makes the whole thing a table
; you sit at rather than software you operate (ROOM_AND_SHEET.md R3, THE_TABLE.md section 6).
;
; THE ROOM IS THE ENTIRE UI. There are no menu screens anywhere in this game - no main menu, no save
; menu, no character screen, no level-up modal, no inventory panel. Every place a normal RPG opens a
; panel, this has an object:
;
;     the shelf      the campaign as a book   save files and campaign select
;     the bookcase   every campaign, and the  the main menu, and the Workshop door
;                    blanks that start one
;     the sheet      on the table             the character screen
;     the corkboard  map and pinned notes     the quest log
;     the dice case  what you have earned     the collection screen
;     the box lid    loose minis in it        the bestiary
;     the window     light, weather, hour     a time-of-day readout
;     the door                                quit
;
; That deletion is the point. It is cheaper AND better, and check-room.ps1 holds the build to it by
; looking for a menu scene and failing if it finds one.
;
; THE TABLE SITS INSIDE THE ROOM, instanced whole. The room was added AROUND a table that already
; worked rather than the table being rebuilt inside a new scene, so nothing playable before R3
; stopped being playable during it - and table.tscn stays openable on its own, which is what every
; check script and every eye check since B0 has run against.
;
; Nothing in here is expensive: one room, one light source, static props, and a shelf that gains
; objects (THE_TABLE.md section 6). The room's job is to accumulate, not to render.

[ext_resource type="PackedScene" path="res://table.tscn" id="1_table"]
[ext_resource type="Script" path="res://Room/Room.cs" id="2_room"]
[ext_resource type="Script" path="res://Room/Furniture.cs" id="3_prop"]
[ext_resource type="Script" path="res://Book/Bookcase.cs" id="4_case"]
[ext_resource type="Script" path="res://Book/Opened.cs" id="5_open"]
[ext_resource type="Script" path="res://Book/Help.cs" id="6_help"]
[ext_resource type="Script" path="res://Access/Narrator.cs" id="7_reader"]
[ext_resource type="Script" path="res://Access/Captioned.cs" id="8_caption"]
[ext_resource type="Script" path="res://Access/Hands.cs" id="9_hands"]
[ext_resource type="Script" path="res://Access/Reaching.cs" id="10_access"]

[sub_resource type="Environment" id="Environment_room"]
background_mode = 1
background_color = Color(0.03, 0.028, 0.026, 1)
ambient_light_source = 2
ambient_light_color = Color(0.42, 0.40, 0.44, 1)
ambient_light_energy = 0.18

; the walls: one box, inverted, so the room is the inside of it. Cheaper than four planes and it
; cannot develop a gap at a corner
; DARK AND GREY, and taken down twice. R3 painted them 0.27/0.24/0.21, a warm mid-brown, and a warm
; mid-brown lit by a warm lamp is the brightest thing in the picture after the table - which is
; backwards, because the walls are the part nobody is meant to look at. 0.17 was not far enough
; (the eye check said so again on 2026-09-17), and taking the last of the warmth out of the hue
; matters as much as the value: a touch COOLER than neutral is what reads as grey under a lamp this
; warm, where a neutral grey just reads as more brown.
[sub_resource type="StandardMaterial3D" id="Mat_wall"]
albedo_color = Color(0.105, 0.108, 0.116, 1)
roughness = 1.0
cull_mode = 1

[sub_resource type="BoxMesh" id="Mesh_walls"]
size = Vector3(5.0, 2.7, 5.0)

; the floor goes with them, or it reads warmer than the wall standing behind it
[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.082, 0.084, 0.09, 1)
roughness = 1.0

[node name="Room" type="Node3D"]
script = ExtResource("2_room")
TablePath = NodePath("Table")
SheetPath = NodePath("Table/Sheet")
FightPath = NodePath("Table/Fight")
BookcasePath = NodePath("Bookcase")
OpenedPath = NodePath("Book")
HelpPath = NodePath("Help")
DmPath = NodePath("Table/Dm")
ReachingPath = NodePath("Reaching")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_room")

; ONE LIGHT SOURCE (THE_TABLE.md section 6). A lamp over the table, warm and low, which is what
; makes the room read as a room somebody is sitting in at night rather than a lit box.
[node name="Lamp" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.08, 1.05, 0.1)
light_color = Color(1, 0.85, 0.66, 1)
light_energy = 3.2
omni_range = 4.5
shadow_enabled = true

[node name="Walls" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.31, 0)
mesh = SubResource("Mesh_walls")
material_override = SubResource("Mat_wall")

[node name="Floor" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.04, 0)
mesh = SubResource("Mesh_walls")
material_override = SubResource("Mat_floor")
visible = false

; THE TABLE, INSIDE THE ROOM. Everything built since B0 - the board, the tray, the DM, the
; companion, the sheet - comes in with it, placed exactly as table.tscn places it. The room knows
; where the table stands; the table has never known and still does not.
[node name="Table" parent="." instance=ExtResource("1_table")]

; ---- THE OBJECTS THAT REPLACE THE MENUS -------------------------------------------------------
;
; Each is interactive in place. None opens a menu; each IS the thing (R3). Where they stand is set
; here, in the room's own space, and nothing inside Furniture.cs knows where it is.

; BOXED CAMPAIGNS ON A SHELF - the save files and the campaign select. Every finished campaign adds
; a box; boss trophies land on it; a box you take down IS the versioned JSON P6 writes (R4).
[node name="Shelf" type="Node3D" parent="." groups=["furniture"]]
script = ExtResource("3_prop")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.5, 0.95, -1.9)
Is = 0
Size = Vector3(1.1, 0.06, 0.28)
Wood = Color(0.33, 0.27, 0.19, 1)

; THE CHARACTER SHEET. The paper itself lives on the table (table.tscn); this is the shelf-side
; handle on it, so the room's own list of objects is complete and the "touch only objects" walk has
; something to touch for it.
[node name="Sheet" type="Node3D" parent="." groups=["furniture"]]
script = ExtResource("3_prop")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.78, 0.0, 0.16)
Is = 1
Size = Vector3(0.3, 0.004, 0.4)
Wood = Color(0.92, 0.9, 0.83, 1)

; A CORKBOARD WITH MAP AND NOTES - the quest log. Old maps get pinned to it and layered over, so it
; accumulates the same way the shelf does.
[node name="Corkboard" type="Node3D" parent="." groups=["furniture"]]
script = ExtResource("3_prop")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.3, 1.25, -2.4)
Is = 2
Size = Vector3(1.0, 0.7, 0.03)
Wood = Color(0.45, 0.33, 0.2, 1)

; A DICE CASE - the collection screen. Dice you have earned go in it.
[node name="DiceCase" type="Node3D" parent="." groups=["furniture"]]
script = ExtResource("3_prop")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.85, 0.02, 0.42)
Is = 3
Size = Vector3(0.22, 0.05, 0.14)
Wood = Color(0.24, 0.2, 0.17, 1)

; THE BOX LID HOLDING LOOSE MINIS - the bestiary. Everything you have met, lying in a lid.
[node name="BoxLid" type="Node3D" parent="." groups=["furniture"]]
script = ExtResource("3_prop")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.95, 0.01, -0.3)
Is = 4
Size = Vector3(0.34, 0.04, 0.24)
Wood = Color(0.3, 0.26, 0.22, 1)

; A WINDOW - time of day, weather, season. THE_TABLE.md section 9 leaves "does it reflect real-world
; time" open, and it stays open: this is the object, not the answer.
[node name="Window" type="Node3D" parent="." groups=["furniture"]]
script = ExtResource("3_prop")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.4, 1.5, -0.6)
Is = 5
Size = Vector3(0.05, 0.9, 0.7)
Wood = Color(0.18, 0.22, 0.3, 1)

; THE DOOR - quit. The one irreversible object in the room, so it is the one that asks.
[node name="Door" type="Node3D" parent="." groups=["furniture"]]
script = ExtResource("3_prop")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.4, 1.0, 0.9)
Is = 6
Size = Vector3(0.06, 2.0, 0.85)
Wood = Color(0.29, 0.22, 0.16, 1)

; ---- PHASE BK: THE BOOK AND THE BOOKCASE ------------------------------------------------------
;
; THE BOOKCASE IS THE MAIN AREA (BK2) - a second corner of the same room, and the thing a main menu
; would have been. Every campaign stands on it as a book, one per character; what you have collected
; sits beside them; and a row of plain, blank objects along the bottom is the Workshop door, one per
; content type (BK6). You WALK to it rather than opening it, which is the whole test of whether the
; deletion is real.
;
; Against the far wall, at right angles to the shelf under the corkboard, so the two never read as
; the same piece of furniture.
[node name="Bookcase" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -2.36, 0.06, 0.55)
script = ExtResource("4_case")

; THE BOOK, LAID OPEN (BK1, BK3, BK4). Its contents page is the pause menu and is not one, because a
; contents page is a thing a book HAS. It is hidden until a book is picked up, and it goes away when
; the book is shut - a book that stayed open over the table would be a panel with a paper texture on
; it, and that is the one thing this room cannot have.
;
; Over the near edge of the table, where you would actually hold something you were reading.
[node name="Book" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.0, 0.79, 0.62)
script = ExtResource("5_open")

; THE "?" ON THE TABLE (BK3). The one honest button in the game, and it earns it: somebody who cannot
; find how to ask for help has no way to be told where to look. What it DOES is diegetic - the DM
; reaches behind the screen and pushes the rules book across.
[node name="Help" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.52, 0.755, 0.5)
script = ExtResource("6_help")

; ---- PHASE AX: THE WAY IN ----------------------------------------------------------------------
;
; The room has to be playable by somebody who cannot use a mouse, cannot see it, or cannot hear it,
; and none of that is a later pass: retrofitting it is the rewrite the localization work exists as a
; warning about. Four objects, and only two of them are visible.
;
; YOUR OWN HANDS, on your side of the table (AX5). The DM has had hands since D1 and you have not.
; Placeholder geometry, the same placeholder the DM's are, in whatever colour you chose - and gone
; entirely if you would rather they were.
[node name="Hands" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.0, 0.752, 0.78)
script = ExtResource("9_hands")

; THE SOUNDS, IN WORDS (AX4). A card at the near edge, off until asked, showing what was just heard.
; It is a card lying on the table rather than a band across the bottom of the picture, because a band
; across the bottom of the picture is an HUD and this room has none.
[node name="Captions" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.30, 0.755, 0.70)
script = ExtResource("8_caption")

; THE VOICE (AX2). No geometry: it speaks through the platform's own, and keeps a transcript of
; everything it said so a headless check can prove nothing went silent.
[node name="Narrator" type="Node" parent="."]
script = ExtResource("7_reader")

; THE HAND, THE KEYS AND THE DIALS (AX1, AX3, AX4). Last child, so everything it sizes and everything
; it can reach is already standing. It asks the room what there is to reach rather than keeping a list.
[node name="Reaching" type="Node" parent="."]
script = ExtResource("10_access")
NarratorPath = NodePath("../Narrator")
CaptionsPath = NodePath("../Captions")
HandsPath = NodePath("../Hands")
