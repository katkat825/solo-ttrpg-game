[ext_resource type="Script" path="res://Companion/HintCord.cs" id="12_cord"]
[ext_resource type="Script" path="res://Dialogue/Talk.cs" id="13_talk"]
[ext_resource type="Script" path="res://Camp/Camp.cs" id="14_camp"]
[ext_resource type="Script" path="res://Sheet/Sheet.cs" id="15_sheet"]
[ext_resource type="Script" path="res://Explore/Walkabout.cs" id="16_walk"]
[ext_resource type="Script" path="res://Explore/Response.cs" id="17_response"]
[ext_resource type="Script" path="res://Loot/Stack.cs" id="18_loot"]
[ext_resource type="Script" path="res://Room/Leaning.cs" id="19_leaning"]
[ext_resource type="Script" path="res://Room/Dressed.cs" id="20_dressed"]
[ext_resource type="Texture2D" path="res://textures/tray_wood/color.jpg" id="3_color"]
[ext_resource type="Texture2D" path="res://textures/tray_wood/roughness.jpg" id="4_rough"]
[ext_resource type="Texture2D" path="res://textures/tray_wood/normalgl.jpg" id="5_normal"]

[sub_resource type="Environment" id="Environment_room"]
background_mode = 1
background_color = Color(0.05, 0.045, 0.04, 1)
ambient_light_source = 2
ambient_light_color = Color(0.56, 0.58, 0.64, 1)
ambient_light_energy = 0.35

; the same oak as the tray, but a table is not a tray: the grain repeats over its own size rather
; than over the tray's, and the parallax is left off because nothing is seen close enough to
; benefit and a 2.4 m plane at this angle is exactly where it goes wrong
[sub_resource type="StandardMaterial3D" id="Mat_table"]
albedo_color = Color(0.62, 0.58, 0.54, 1)
albedo_texture = ExtResource("3_color")
roughness_texture = ExtResource("4_rough")
roughness_texture_channel = 4
normal_enabled = true
normal_texture = ExtResource("5_normal")
uv1_scale = Vector3(9, 9, 9)

[sub_resource type="BoxMesh" id="Mesh_table"]
size = Vector3(2.4, 0.04, 1.5)

[node name="Table" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_room")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, 0.4096, -0.2868, 0, 0.5736, 0.8192, 0.5, -0.7094, 0.4967, 0, 1.2, 0.8)
light_energy = 1.2
shadow_enabled = true
shadow_bias = 0.02
shadow_normal_bias = 0.5
directional_shadow_max_distance = 4.0

; pitched 60 degrees down, aimed between the board and the tray, 1.55 m back along that line - measured
; headlessly against tan(fov/2) at 16:9, and the near right corner of the tray is the tight one
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.5, 0.8660254, 0, -0.8660254, 0.5, 0.08, 1.3423, 0.805)
current = true
fov = 35.0

; the table itself, 1 mm below everything standing on it - close enough to look like contact,
; far enough that no two faces are coplanar and flicker against each other
[node name="Tabletop" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.08, -0.041, 0.03)
mesh = SubResource("Mesh_table")
material_override = SubResource("Mat_table")

; THE CHARACTER SHEET (ROOM_AND_SHEET.md R0-R2, THE_TABLE.md section 5).
;
; A piece of paper, lying on the table to the player's right where a real one would be, at the
; table's own scale and in the table's own light. You fill it in by touching the blanks; the DM
; picks it up and reads it; and everything that happens in play is written on it in pencil.
;
; IT IS THE CHARACTER, not a view of one. The hero thrown on the tray is assembled from this every
; time, so there is nothing anywhere else that could drift from it - which is what deletes the
; character screen, the level-up modal and the inventory panel in one go.
;
; Laid flat (pitched back off the vertical so the fixed camera reads it as paper on a table rather
; than a poster) and handed the DM, so the hands can come across and take it (R1).
;
; A4, AND CLEAR OF THE TRAY. The eye check found it 8 cm inside the dice tray's right wall with its
; own right edge off the side of the screen, and both were the same cause: at 0.30 x 0.40 it was an
; A3 sheet, and the board, the tray and an A3 sheet do not fit across this camera's frame. A real
; character sheet is A4 (Sheet.cs Width/Height now say so), which is 9 cm narrower, and that is
; exactly the room the three of them needed.
[node name="Sheet" type="Node3D" parent="."]
script = ExtResource("15_sheet")
transform = Transform3D(1, 0, 0, 0, 0.1736482, 0.9848078, 0, -0.9848078, 0.1736482, 0.765, -0.038, 0.05)
DmPath = NodePath("../Dm")

; the board does not own a tray and the tray does not know there is a board - only the table
; knows both are standing on it, so this is where they are introduced (B4)
; shifted 3 cm left of where B0 put it, and the tray 5 cm, so the board, the tray and the sheet
; stand apart instead of touching - see the note on the Sheet above
[node name="Board" parent="." instance=ExtResource("1_board")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.36, -0.014, -0.03)
TrayPath = NodePath("../DiceTray")
SheetPath = NodePath("../Sheet")

[node name="DiceTray" parent="." instance=ExtResource("2_tray")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.3, 0, 0.09)
CompanionPath = NodePath("../Companion")

; THE DM, ACROSS THE TABLE (DM_PRESENCE.md D0). The screen stands at the far edge, art facing the
; player, and the hands come from behind it - which is the loading boundary D0 establishes:
; everything the DM produces comes from somewhere you cannot see.
;
; PLACED HERE IN WORLD SPACE like everything else on this table, and nothing inside it knows where
; it stands. Rotated to face the camera, and far enough back that the hands have table to reach
; ACROSS - the reach is most of what makes a gesture read.
[node name="Dm" type="Node3D" parent="."]
script = ExtResource("10_dm")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.02, -0.041, -0.46)
BoardPath = NodePath("../Board")

; THE COMPANION, ALIVE ON THE TABLE (COMPANION_AND_DIALOGUE.md W1, THE_TABLE.md section 4).
;
; Every mini on the table is inert; this one is not. It sits ALONGSIDE the map with its chin on the
; edge - on the table, never on the board - which is the conceit and also the guarantee: there is
; no square under it, so nothing can give it a turn.
;
; PLACED HERE IN WORLD SPACE like everything else on this table. The wolf's perch is the map's left
; edge, so this sits just off the board's western side and a little forward of it, where the fixed
; camera can see its head turn.
;
; It is handed the screen and the tray so it has something to LOOK AT: it turns to the screen when
; it hears the DM roll, and follows the dice when they are in the air. Neither is required - unset
; them and it simply stares ahead.
;
; The placeholder body is deliberate (W1: build the idles first). The model arrives later and
; nothing about the behaviour changes when it does.
; AT THE DICE TRAY, not the map's edge (moved 2026-09-17, on the eye check's own call). It sits on
; the table just behind the tray, where it can watch the dice come down - which is what most of its
; idles are about, and the tray is where the thing it reacts to actually happens.
;
; That is Perch.TrayRim rather than Perch.MapEdge, and hearthguard's wolf card says so. THE PERCH IS
; NOW HONOURED: handed the tray and the board, the companion places itself off whichever of them its
; card names, so the card and this transform can no longer disagree. The transform below is what it
; lands on and is left here for a table opened with neither wired up.
;
; ITS SIZE IS THE CARD'S TOO. A wolf is 1; a raven or a reliquary ships a smaller one and the thing
; beside the table reads at its own scale without a line of this scene changing.
;
; The map's left edge is now clear for the initiative list and the hint cord, which were crowding
; the wolf there anyway.
;
; IT IS STILL A PLACEHOLDER, deliberately (W1: build the idles first, the model arrives later and
; nothing about the behaviour changes when it does) - a silhouette rather than a crate since the
; second eye check, so what it is doing is at least legible. Parked in DEFERRED.md with the DM's
; hands and screen.
[node name="Companion" type="Node3D" parent="."]
script = ExtResource("11_companion")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.3, -0.013, -0.27)
CompanionId = "hearthguard.wolf"
ScreenPath = NodePath("../Dm")
TrayPath = NodePath("../DiceTray")
BoardPath = NodePath("../Board")

; THE HINT CORD (W4). Pulled, never pushed: the player asks, and the companion never volunteers the
; solution. Three rungs on repeat asks, then it notices it is being over-asked and says so in
; character. Press H, or reach for the cord itself.
;
; It gates NOTHING. Every rung is a line, and every piece of information behind one is reachable
; another way - that is a rule about how campaigns are authored and no validator can hold you to it.
; brought 3 cm in from the table's left edge: measured off the side of the camera frame, and a
; cord you are told to reach for is not much use hanging outside the picture
[node name="HintCord" type="Node3D" parent="."]
script = ExtResource("12_cord")
transform = Transform3D(1, 0, 0, 0, 0.7071068, 0.7071068, 0, -0.7071068, 0.7071068, -0.625, 0.02, 0.33)
CompanionPath = NodePath("../Companion")
DmPath = NodePath("../Dm")

; A CONVERSATION, WHEN THERE IS ONE (W0). Idle until something starts it; the choices are laid out
; as cards on the table in front of you, because THE_TABLE.md section 6 is a hard rule and a
; dialogue menu is the most tempting panel in the game to bolt over the scene.
;
; A line goes to whoever says it: the companion's own lines come out of its mouth, the DM's are
; pushed across the table on a note (D5), and anybody else's lands in this node's own bubble.
[node name="Talk" type="Node3D" parent="."]
script = ExtResource("13_talk")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.02, -0.038, 0.26)
CompanionPath = NodePath("../Companion")
DmPath = NodePath("../Dm")

; CAMP (W3). A scene, not a rest button with a menu behind it: a fire on the table, the companion
; coming over to sit by it, and one conversation about the day you actually had. The rest effects
; (Strain cleared, one Condition slept off, Nerve back to 3) are core/'s Rest.Camp and know nothing
; about any of this.
[node name="Camp" type="Node3D" parent="."]
script = ExtResource("14_camp")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.02, -0.038, 0.22)
CompanionPath = NodePath("../Companion")

; WALKING A PLACE (Phase T). The board has only ever known a fight; this is the second mode it
; runs, on the same mat, with the same hero and the same click. Asleep unless a campaign is asked
; for - with CampaignId empty and no --campaign= on the command line this node does nothing at all,
; and the table boots straight into a fight exactly as it has since B0.
;
; LISTED ABOVE THE FIGHT ON PURPOSE. Siblings enter the tree in this order, so this is the last
; instant the fight standing below can be told to stand down - and it is told, rather than raced,
; when a walk is the thing being played. It also reads its figures off that fight, so the minis a
; fight uses are still named in exactly one place and it is this scene.
[node name="Walkabout" type="Node3D" parent="."]
script = ExtResource("16_walk")
BoardPath = NodePath("../Board")
DmPath = NodePath("../Dm")
CompanionPath = NodePath("../Companion")
TalkPath = NodePath("../Talk")
LootPath = NodePath("../Loot")
SheetPath = NodePath("../Sheet")
TrayPath = NodePath("../DiceTray")
FightPath = NodePath("../Fight")
RoomPath = NodePath("../..")
CampaignId = ""
StartAt = ""

; HOW YOU ANSWER A MOMENT. Cards in front of the board for the things you could do to what is
; standing there; the DM's note, pushed across, for a set of options somebody wrote down. Neither
; stands between moments - an offer is made, answered and swept.
[node name="Response" type="Node3D" parent="Walkabout"]
script = ExtResource("17_response")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.36, -0.036, 0.34)
DmPath = NodePath("../../Dm")

; THE STACK OF CARDS BESIDE YOU, which is the whole inventory. Anything you gain is dealt across as
; a card and goes on it; turning one over reads it. Near the player's own edge of the table, left of
; the sheet, where you would keep what you are carrying.
[node name="Loot" type="Node3D" parent="."]
script = ExtResource("18_loot")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.30, -0.036, 0.62)
DmPath = NodePath("../Dm")

; THE CAMERA, LEANING IN. It does not replace the fixed 60 degrees - it reads it at boot and goes
; back to it - it adds leaning over a thing to read it, picking a handheld thing up, and the mat's
; own pan and zoom for a place bigger than the table. Escape sits back; - and = are how close; the
; arrows move your head across a big mat.
[node name="Leaning" type="Node3D" parent="."]
script = ExtResource("19_leaning")
CameraPath = NodePath("../Camera3D")
BoardPath = NodePath("../Board")

; THE PROPS, DISCRETE (Phase T). None of the things on this table is welded to it: the mat swaps
; every time you walk somewhere, and the tray, the screen, the sheet, the turn order and the dice
; can each be swapped for another version of themselves. The tray already wears its own felts; the
; rest are pointed at here and wait on art, which is what the empty Wardrobe means.
;
; COSMETIC, ALWAYS. A finer tray is finer, never better - the moment a prop is mechanically better,
; every session becomes a question about your inventory instead of the dungeon.
[node name="Dressed" type="Node3D" parent="."]
script = ExtResource("20_dressed")
TrayPath = NodePath("../DiceTray")
Props = {
"dice": NodePath("../DiceTray"),
"initiative": NodePath("../Board"),
"mat": NodePath("../Board"),
"screen": NodePath("../Dm"),
"sheet": NodePath("../Sheet"),
"tray": NodePath("../DiceTray")
}

; THE FIGHT (COMBAT_LOOP.md C0). It needs the board and the tray both, and the table is the one
; place that knows both are standing on it - the same reason the board's TrayPath is set here and
; not inside board.tscn. Last child, so the board has finished loading its map and made its hero
; by the time this asks for one.
[node name="Fight" type="Node3D" parent="."]
script = ExtResource("7_fight")
BoardPath = NodePath("../Board")
TrayPath = NodePath("../DiceTray")
DmPath = NodePath("../Dm")
CompanionPath = NodePath("../Companion")
SheetPath = NodePath("../Sheet")
; the room the table is standing in, when it is standing in one: the room owns the saves folder and
; does the writing. Opened on its own this resolves to the scene tree's root, which is not a Room,
; and the fight plays exactly as it always has with nothing written down
RoomPath = NodePath("../..")
RivalPiece = ExtResource("6_rival")
RabblePiece = ExtResource("8_rabble")
DreadPiece = ExtResource("9_dread")

; THE ROOM, said in one place (C2). Four Rabble in a loose ring one square off the hero's start
; at (2, 6), and the Rival two squares behind them - so the fight is joined on the first turn
; rather than opening with everybody walking, and the Rabble are already the positioning problem
; CORE_RULES.md section 8 built them to be. Phase P reads these out of the campaign's own map.
RabbleAt = Array[Vector2i]([Vector2i(1, 5), Vector2i(3, 5), Vector2i(1, 7), Vector2i(3, 7)])
RivalAt = Vector2i(4, 4)

; NO BOSS IN THIS ROOM. One Dread per chapter (CORE_RULES.md section 8), so most rooms have none -
; set DreadAt to a square (say Vector2i(8, 2), through the door in the east half) to fight one.
; Phase P reads the encounter out of the campaign and this export goes with it.
DreadAt = Vector2i(-1, -1)

; WHAT THE HERO IS CARRYING (P1). Empty means whatever his statblock gave him - a d6 axe. Put an
; item id from a campaign's items/ folder here and he carries that instead: "cold_iron_axe" is a
; d8 that leaves people Reeling, "scale_coat" is +1 Defense. That is the whole of what a better
; weapon is (CORE_RULES.md pillar 3), and it is a line of scene data and a file.
HeroWeapon = ""
HeroArmour = ""

; THE NOTE THE TURN PUSHES ACROSS (V2). Its own Response rather than the walk's: the two are
; never both asking - a fight is an Episode inside a place and the walk stands down for it - but
; one Response answering to two owners would have to be told which question it was carrying, and
; a second node costs nothing. Same DM, same hands, same paper.
[node name="Asking" type="Node3D" parent="Fight"]
script = ExtResource("17_response")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.36, -0.036, 0.34)
DmPath = NodePath("../../Dm")
