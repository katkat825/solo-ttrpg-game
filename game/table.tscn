[gd_scene load_steps=22 format=3]

; THE TABLE. The game's main scene from B0 onward, and the shipped view of it.
;
; The tray used to own the room - a camera, a sun and a world environment sat in dice_tray.tscn
; because for M0-M9 the tray WAS the game. B0 puts a board on the table beside it, and one fixed
; camera now has to frame both, so the room moved out here and the tray became what it always
; was: an object standing on a table. F2 is what made that safe - everything in the tray is
; measured in the tray's own space, so moving the tray moved the tray and nothing else.
;
; THE CAMERA IS THE ONE THING TO GET RIGHT HERE. Fixed, at the 60 degrees off the felt that
; idea_notes.txt asks for - the angle a player actually sees a table from, close enough to read
; the numerals on the dice and high enough to read the grid as a grid. It sees the tabletop, the
; board and the tray together, and it does not move. THE_BOARD.md B0: get the angle right once.
;
; Everything on the table is placed HERE, in world space, and nothing inside either scene knows
; where it stands.

[ext_resource type="PackedScene" path="res://Board/board.tscn" id="1_board"]
[ext_resource type="PackedScene" path="res://Tray/dice_tray.tscn" id="2_tray"]
[ext_resource type="PackedScene" path="res://Board/rival.tscn" id="6_rival"]
[ext_resource type="PackedScene" path="res://Board/rabble.tscn" id="8_rabble"]
[ext_resource type="PackedScene" path="res://Board/dread.tscn" id="9_dread"]
[ext_resource type="Script" path="res://Fight/Fight.cs" id="7_fight"]
[ext_resource type="Script" path="res://Dm/Dm.cs" id="10_dm"]
